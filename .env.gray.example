# Env for the gray-tier instance (docker-compose.tiers.yml).
# Copy to .env.clean. Use a DIFFERENT ENCRYPTION_KEY than the gray instance's
# .env — the two DBs are independent and must not share key material.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Host port the gray instance publishes on (container stays 3001 internally).
GRAY_PORT=3003

# Providers/keys come from docker/tiers/clean.config.json via
# FREEAPI_CONFIG_PATH (set in docker-compose.tiers.yml). Tier policy:
# docs/provider-tiers.md.
